# Copy to .env. This SQLite URL works locally without database credentials.
DATABASE_URL=sqlite:///zyntara.db
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional: add a Google AI Studio key locally to enable Gemini-generated answers.
# Without a key, the assistant returns a local evidence summary.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL values used by docker-compose.yml; change DATABASE_URL when using Docker.
POSTGRES_USER=zyntara
POSTGRES_PASSWORD=choose-a-strong-password
